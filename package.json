{
  "name": "milko",
  "private": true,
  "version": "0.1.0",
  "description": "MilkO Markdown editor for Orca",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/collect-licenses.test.mjs scripts/package-release.test.mjs scripts/prepare-harper.test.mjs && vitest run",
    "license:collect": "node scripts/collect-licenses.mjs",
    "validate": "orca plugin validate .",
    "check": "orca plugin check .",
    "test:orca": "node scripts/test-orca.mjs",
    "check:orca": "pnpm test:orca && pnpm validate && pnpm check",
    "package": "pnpm build && node scripts/package-release.mjs",
    "verify:package": "node scripts/package-release.mjs --verify",
    "fixtures:release": "node scripts/release-fixtures.mjs",
    "check:release": "pnpm typecheck && pnpm test && pnpm license:collect && pnpm package && pnpm verify:package",
    "dev": "pnpm build && orca plugin dev watch .",
    "build:watch": "vite build --watch"
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/view": "6.43.15",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "diff-match-patch": "1.0.5",
    "dompurify": "3.4.17",
    "harper.js": "3.0.0",
    "mermaid": "12.3.0",
    "prosemirror-search": "1.1.1"
  },
  "devDependencies": {
    "@types/diff-match-patch": "1.0.36",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
